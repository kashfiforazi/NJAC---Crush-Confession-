{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "A confession post submitted by a user.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "nickname": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "published", "rejected"] },
        "createdAt": { "type": "timestamp" },
        "publishedAt": { "type": "timestamp" },
        "viewsCount": { "type": "number" },
        "reactionCounts": {
          "type": "object",
          "properties": {
            "like": { "type": "number" },
            "love": { "type": "number" },
            "sad": { "type": "number" },
            "wow": { "type": "number" }
          }
        },
        "authorUid": { "type": "string" }
      },
      "required": ["title", "content", "category", "status", "createdAt", "viewsCount", "authorUid"]
    },
    "Reaction": {
      "title": "Reaction",
      "description": "A user's reaction to a post.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["like", "love", "sad", "wow"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["type", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comment on a post",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorUid": { "type": "string" },
        "content": { "type": "string" },
        "nickname": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["postId", "authorUid", "content", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "A document indicating a user is an admin.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["email", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "A category for posts.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["name", "slug"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Stores all confessions (pending and published)."
    },
    "/posts/{postId}/reactions/{userId}": {
      "schema": { "$ref": "#/entities/Reaction" },
      "description": "Stores user reactions to prevent duplicate votes."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Stores all comments for posts."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Stores administrator privileges."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Dynamic categories for posts."
    }
  }
}
