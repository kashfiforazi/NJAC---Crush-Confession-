{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "A confession post submitted by a user.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "nickname": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "published", "rejected"] },
        "createdAt": { "type": "timestamp" },
        "publishedAt": { "type": "timestamp" },
        "viewsCount": { "type": "number" },
        "reactionCounts": {
          "type": "object",
          "properties": {
            "like": { "type": "number" },
            "love": { "type": "number" },
            "sad": { "type": "number" },
            "wow": { "type": "number" }
          }
        },
        "authorUid": { "type": "string" }
      },
      "required": ["title", "content", "category", "status", "createdAt", "viewsCount", "authorUid"]
    },
    "NewsBlog": {
      "title": "News/Blog",
      "description": "A news item or blog post.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["news", "blog"] },
        "url": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["title", "content", "type", "createdAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "An administrative notice shown on the site.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["text", "active", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "coverURL": { "type": "string" },
        "totalPoints": { "type": "number", "description": "Combined points from games and posts." },
        "gamePoints": { "type": "number", "description": "Points earned from playing games." },
        "postsPoints": { "type": "number", "description": "Points earned from confessions and engagement." },
        "isBanned": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "rollNumber": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "bio": { "type": "string" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["displayName", "email", "createdAt"]
    },
    "Follow": {
      "title": "Follow",
      "description": "A follow relationship between users.",
      "type": "object",
      "properties": {
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["followerId", "followingId", "createdAt"]
    },
    "CommunityMessage": {
      "title": "Community Message",
      "description": "A message in the global community chat.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["authorUid", "content", "createdAt"]
    },
    "Reaction": {
      "title": "Reaction",
      "description": "A user's reaction to a post.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["like", "love", "sad", "wow"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["type", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comment on a post",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorUid": { "type": "string" },
        "content": { "type": "string" },
        "nickname": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhotoURL": { "type": "string" },
        "authorVerified": { "type": "boolean" },
        "isAdmin": { "type": "boolean" },
        "isAnonymous": { "type": "boolean" },
        "parentId": { "type": "string", "description": "ID of the parent comment if this is a reply." },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["postId", "authorUid", "content", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "A document indicating a user is an admin.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["email", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "A category for posts.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "AdminProfile": {
      "title": "Admin Profile",
      "description": "The official identity of the NJAC Admin team.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "photoURL": { "type": "string" },
        "coverURL": { "type": "string" },
        "bio": { "type": "string" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["displayName"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Stores all confessions (pending and published)."
    },
    "/posts/{postId}/reactions/{userId}": {
      "schema": { "$ref": "#/entities/Reaction" },
      "description": "Stores user reactions to prevent duplicate votes."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Stores all comments for posts."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Stores administrator privileges."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Dynamic categories for posts."
    },
    "/news_blogs/{id}": {
      "schema": { "$ref": "#/entities/NewsBlog" },
      "description": "Stores news and blog posts."
    },
    "/notices/{id}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Stores announcements from admins."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and moderation status."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/Follow" },
      "description": "Stores following relationships."
    },
    "/community_messages/{messageId}": {
      "schema": { "$ref": "#/entities/CommunityMessage" },
      "description": "Stores global community chat messages."
    },
    "/banners/{bannerId}": {
      "schema": { "type": "object", "properties": { "imageUrl": { "type": "string" }, "link": { "type": "string" }, "title": { "type": "string" }, "order": { "type": "number" } } },
      "description": "Stores home page slider banners."
    },
    "/adminSettings/{id}": {
      "schema": { "$ref": "#/entities/AdminProfile" },
      "description": "Stores global admin identity configurations."
    },
    "/conversations/{convId}": {
      "schema": {
        "type": "object",
        "properties": {
          "participants": { "type": "array", "items": { "type": "string" } },
          "lastMessage": { "type": "string" },
          "updatedAt": { "type": "timestamp" }
        }
      },
      "description": "Stores active chat threads between users."
    },
    "/messages/{msgId}": {
      "schema": {
        "type": "object",
        "properties": {
          "conversationId": { "type": "string" },
          "participants": { "type": "array", "items": { "type": "string" } },
          "senderId": { "type": "string" },
          "receiverId": { "type": "string" },
          "content": { "type": "string" },
          "createdAt": { "type": "timestamp" }
        },
        "required": ["conversationId", "participants", "senderId", "receiverId", "content", "createdAt"]
      },
      "description": "Stores individual chat messages. Only readable for 24 hours."
    }
  }
}
