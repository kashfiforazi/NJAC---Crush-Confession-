rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation definitions
    function isPostValid(data) {
      return data.keys().hasAll(['content', 'category', 'status', 'createdAt', 'viewsCount', 'authorUid']) 
          && (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 200))
          && data.content is string && data.content.size() > 0 && data.content.size() <= 5000
          && data.category is string && data.category.size() > 0 && data.category.size() <= 50
          && data.status in ['pending', 'published', 'rejected']
          && data.createdAt is timestamp
          && data.viewsCount is number
          && data.authorUid == request.auth.uid
          && (!data.keys().hasAny(['nickname']) || (data.nickname is string && data.nickname.size() <= 50))
          && (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
          && (!data.keys().hasAny(['slug']) || (data.slug is string && data.slug.size() <= 200))
          && (!data.keys().hasAny(['reactionCounts']) || data.reactionCounts is map);
    }

    function isCommentValid(data) {
       return data.keys().hasAll(['postId', 'authorUid', 'content', 'createdAt'])
          && data.postId is string
          && data.authorUid == request.auth.uid
          && data.content is string && data.content.size() > 0 && data.content.size() <= 1000
          && data.createdAt is timestamp
          && (!data.keys().hasAny(['nickname']) || (data.nickname is string && data.nickname.size() <= 50))
          && (!data.keys().hasAny(['parentId']) || (data.parentId is string));
    }

    function isNewsBlogValid(data) {
      return data.keys().hasAll(['title', 'content', 'type', 'createdAt', 'authorUid'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 500
          && data.content is string && data.content.size() > 0 && data.content.size() <= 50000
          && data.type in ['news', 'blog']
          && data.createdAt is timestamp
          && data.authorUid == request.auth.uid
          && (!data.keys().hasAny(['url']) || (data.url is string && data.url.size() <= 1000))
          && (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 1000));
    }

    function isUserValid(data) {
      return data.keys().hasAll(['displayName', 'createdAt'])
          && data.displayName is string
          && data.createdAt is timestamp
          && (!data.keys().hasAny(['email']) || data.email is string || data.email == null)
          && (!data.keys().hasAny(['photoURL']) || data.photoURL is string || data.photoURL == null);
    }

    // Rules
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId && isUserValid(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && incoming().password == 'NJAC26' && userId == request.auth.uid;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news_blogs/{itemId} {
      allow read: if true;
      allow create: if isAdmin() && isNewsBlogValid(incoming());
      allow update, delete: if isAdmin();
    }

    match /posts/{postId} {
      // Read: published posts are public, pending/rejected only for admins and the author
      allow read: if (existing().status == 'published') || isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid);
      
      // Create: any signed in user (anonymous) can create a pending post, admins can create any valid post
      allow create: if (isSignedIn() && isPostValid(incoming()) && incoming().status == 'pending' && incoming().viewsCount == 0)
                    || (isAdmin() && isPostValid(incoming()));
      
      // Update: Admins can update anything. Users can only increment views and reactions
      allow update: if isSignedIn() && (
        isAdmin() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']) && incoming().viewsCount > existing().viewsCount) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['reactionCounts']))
      );

      allow delete: if isAdmin();

      match /reactions/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn() 
                           && userId == request.auth.uid
                           && incoming().keys().hasAll(['type', 'createdAt'])
                           && incoming().type in ['like', 'love', 'haha', 'sad', 'wow']
                           && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() 
                    && isCommentValid(incoming());
      allow update: if isSignedIn() 
                    && existing().authorUid == request.auth.uid 
                    && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt'])
                    && incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 1000;
      allow delete: if isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid);
    }
  }
}
